BOT_TOKEN=
MINI_APP_PORT=8080
# адрес мини-приложения: для MAX нужен https-домен, без Docker — http://localhost:8080
MINI_APP_URL=http://localhost
# 1 — кнопка «Открыть приложение» в меню. Включать только после того,
# как этот же URL привязан к боту как мини-приложение в кабинете MAX.
MINI_APP_OPEN_BUTTON=
MINIAPP_DEV_USER_ID=

# Госуслуги (ЕСИА): вход включается, когда заполнены все четыре параметра
ESIA_ENV=prod
ESIA_CLIENT_ID=
ESIA_REDIRECT_URI=
ESIA_CERT_HASH=
ESIA_SIGNER_URL=
ESIA_SIGNER_TOKEN=
ESIA_SCOPE=
SFR_LABOR_BOOK_URL=
SFR_LABOR_BOOK_TOKEN=

NODE_TLS_REJECT_UNAUTHORIZED=1
